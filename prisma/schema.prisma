generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique // e.g. IND, UAE, KSA
  users       User[]
  departments Department[]
  projects    Project[]
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
  users     User[]

  @@unique([name, companyId])
}

model User {
  id                 Int         @id @default(autoincrement())
  name               String
  email              String      @unique
  passwordHash       String
  role               String      @default("EMPLOYEE") // ADMIN | MANAGER | EMPLOYEE
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(true)
  emailNotifications Boolean     @default(true)
  avatarPath         String?
  jobTitle           String?
  lastSeenAt         DateTime?
  requiresApproval   Boolean     @default(false) // can't self-complete; owner approves from Review
  company            Company     @relation(fields: [companyId], references: [id])
  companyId          Int
  department         Department? @relation(fields: [departmentId], references: [id])
  departmentId       Int?
  createdAt          DateTime    @default(now())

  tasksAssigned      Task[]              @relation("assignee")
  tasksCreated       Task[]              @relation("creator")
  comments           TaskComment[]
  notes              Note[]
  timeEntries        TimeEntry[]
  projectMembers     ProjectMember[]
  projectsCreated    Project[]
  attachments        Attachment[]
  discussionMessages DiscussionMessage[]
  notifications      Notification[]
  taskActivities     TaskActivity[]
  noteShares         NoteShare[]
  messagesSent       DirectMessage[]     @relation("dmSender")
  messagesReceived   DirectMessage[]     @relation("dmRecipient")
  activeTimer        TaskTimer?
  pushSubscriptions  PushSubscription[]
  timesheetSubmissions TimesheetSubmission[] @relation("tsSubmitter")
  timesheetReviews     TimesheetSubmission[] @relation("tsReviewer")
  passwordReset      PasswordReset?
}

/**
 * A pending self-service password reset. Holds a hashed one-time code (OTP)
 * that the user receives by email and enters to set a new password. One active
 * reset per user; it's replaced on re-request and deleted once used/expired.
 */
model PasswordReset {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      String          @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | ARCHIVED
  company     Company         @relation(fields: [companyId], references: [id])
  companyId   Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime        @default(now())
  tasks       Task[]
  members     ProjectMember[]
  timeEntries TimeEntry[]
}

model ProjectMember {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@id([projectId, userId])
}

model Task {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  status      String        @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE
  priority    String        @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  startDate     DateTime?
  dueDate       DateTime?
  recurrence    String? // null | DAILY | WEEKLY | MONTHLY — recreates on completion
  estimateHours Float? // effort estimate in hours, powers the workload view
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?
  assignee    User?         @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  createdBy   User          @relation("creator", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?
  deletedAt   DateTime?
  comments    TaskComment[]
  timeEntries TimeEntry[]
  attachments Attachment[]
  timers      TaskTimer[]

  parent     Task?          @relation("subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  parentId   Int?
  subtasks   Task[]         @relation("subtasks")
  tags       TaskTag[]
  activities TaskActivity[]

  // Dependency edges: `blockedBy` are tasks that must finish before this one;
  // `blocking` are tasks that are waiting on this one.
  blockedBy  TaskDependency[] @relation("blockedTask")
  blocking   TaskDependency[] @relation("blockerTask")
}

/**
 * A "this task is blocked by that task" edge, Asana-style. A task can be blocked
 * by many others and can block many others.
 */
model TaskDependency {
  id        Int  @id @default(autoincrement())
  task      Task @relation("blockedTask", fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int // the task that is blocked
  blocker   Task @relation("blockerTask", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId Int // the task that must be completed first
  createdAt DateTime @default(now())

  @@unique([taskId, blockerId])
  @@index([blockerId])
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  color String    @default("slate")
  tasks TaskTag[]
}

model TaskTag {
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId Int
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@id([taskId, tagId])
}

model TaskActivity {
  id        Int      @id @default(autoincrement())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   Int
  type      String // created | status | assignee | due | priority | details | attachment
  detail    String?
  createdAt DateTime @default(now())
}

model ProjectTemplate {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now())
  items       ProjectTemplateItem[]
}

model ProjectTemplateItem {
  id            Int             @id @default(autoincrement())
  template      ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId    Int
  title         String
  priority      String          @default("MEDIUM")
  dueOffsetDays Int? // due date = project creation date + this many days
  order         Int             @default(0)
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  body      String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
}

model Note {
  id        Int         @id @default(autoincrement())
  title     String
  body      String      @default("")
  color     String      @default("default")
  pinned    Boolean     @default(false)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
  deletedAt DateTime?
  shares    NoteShare[]
}

model NoteShare {
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@id([noteId, userId])
}

model DirectMessage {
  id          Int      @id @default(autoincrement())
  body        String
  sender      User     @relation("dmSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId    Int
  recipient   User     @relation("dmRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId Int
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  attachments Attachment[]

  @@index([senderId, recipientId])
  @@index([recipientId, senderId])
}

model Attachment {
  id           Int            @id @default(autoincrement())
  storedName   String         @unique // random name on disk inside UPLOAD_DIR
  originalName String
  mimeType     String
  size         Int
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       Int?
  message      DirectMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId    Int?
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  uploadedById Int
  createdAt    DateTime       @default(now())

  @@index([messageId])
}

model DiscussionMessage {
  id        Int      @id @default(autoincrement())
  body      String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  createdAt DateTime @default(now())
}

model TimeEntry {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?
  date      DateTime
  hours     Float
  note      String?
  source    String   @default("manual") // manual | timer
  createdAt DateTime @default(now())
}

/**
 * An employee's weekly timesheet submitted for a manager to approve. One row
 * per person per week (weekStart is the Sunday 00:00 of that week). Once
 * submitted or approved, that week's entries are locked from further edits.
 */
model TimesheetSubmission {
  id           Int       @id @default(autoincrement())
  user         User      @relation("tsSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  weekStart    DateTime
  status       String    @default("SUBMITTED") // SUBMITTED | APPROVED | REJECTED
  totalHours   Float     @default(0)
  note         String?
  reviewedBy   User?     @relation("tsReviewer", fields: [reviewedById], references: [id])
  reviewedById Int?
  reviewNote   String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?

  @@unique([userId, weekStart])
  @@index([status])
}

/**
 * A browser's Web Push subscription, so we can deliver desktop/mobile push
 * notifications even when the app isn't open. One person can be subscribed from
 * several devices; the endpoint uniquely identifies each browser.
 */
model PushSubscription {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/**
 * A live, running stopwatch for a task. There is at most one per user (enforced
 * by the unique userId) — starting a timer stops any other one first, matching
 * the way tools like Toggl or Asana track "what am I working on right now".
 */
model TaskTimer {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  note      String?
  startedAt DateTime @default(now())
}
