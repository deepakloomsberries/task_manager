generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique // e.g. IND, UAE, KSA
  users       User[]
  departments Department[]
  projects    Project[]
}

model Department {
  id        Int     @id @default(autoincrement())
  name      String
  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
  users     User[]

  @@unique([name, companyId])
}

model User {
  id                 Int         @id @default(autoincrement())
  name               String
  email              String      @unique
  passwordHash       String
  role               String      @default("EMPLOYEE") // ADMIN | MANAGER | EMPLOYEE
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(true)
  jobTitle           String?
  company            Company     @relation(fields: [companyId], references: [id])
  companyId          Int
  department         Department? @relation(fields: [departmentId], references: [id])
  departmentId       Int?
  createdAt          DateTime    @default(now())

  tasksAssigned      Task[]              @relation("assignee")
  tasksCreated       Task[]              @relation("creator")
  comments           TaskComment[]
  notes              Note[]
  timeEntries        TimeEntry[]
  projectMembers     ProjectMember[]
  projectsCreated    Project[]
  attachments        Attachment[]
  discussionMessages DiscussionMessage[]
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      String          @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | ARCHIVED
  company     Company         @relation(fields: [companyId], references: [id])
  companyId   Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime        @default(now())
  tasks       Task[]
  members     ProjectMember[]
  timeEntries TimeEntry[]
}

model ProjectMember {
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@id([projectId, userId])
}

model Task {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  status      String        @default("TODO") // TODO | IN_PROGRESS | REVIEW | DONE
  priority    String        @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate     DateTime?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?
  assignee    User?         @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  createdBy   User          @relation("creator", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  completedAt DateTime?
  comments    TaskComment[]
  timeEntries TimeEntry[]
  attachments Attachment[]
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  body      String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt DateTime @default(now())
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Attachment {
  id           Int      @id @default(autoincrement())
  storedName   String   @unique // random name on disk inside UPLOAD_DIR
  originalName String
  mimeType     String
  size         Int
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId       Int?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById Int
  createdAt    DateTime @default(now())
}

model DiscussionMessage {
  id        Int      @id @default(autoincrement())
  body      String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  Int
  createdAt DateTime @default(now())
}

model TimeEntry {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId    Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId Int?
  date      DateTime
  hours     Float
  note      String?
  createdAt DateTime @default(now())
}
