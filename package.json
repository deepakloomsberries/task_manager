{
  "name": "task_manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "reminders": "tsx scripts/reminders.ts",
    "digest": "tsx scripts/digest.ts",
    "backup": "tsx scripts/backup.ts",
    "timesheet-reminder": "tsx scripts/timesheet-reminder.ts",
    "db:migrate-from-sqlite": "prisma generate --schema prisma/legacy-sqlite/schema.prisma && tsx scripts/migrate-sqlite-to-postgres.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.75.3",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^15.5.26",
    "nodemailer": "^9.1.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
