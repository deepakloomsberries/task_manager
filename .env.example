DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-this-to-a-long-random-string-in-production"

# Public URL of the app — used for links inside notification emails
APP_URL="https://task.donetella.com"

# Where uploaded files are stored on the server (created automatically).
# Defaults to ./uploads inside the project folder if not set.
UPLOAD_DIR="/var/lib/task-manager/uploads"

# Gmail SMTP for email notifications (leave SMTP_USER/SMTP_PASS empty to disable email).
# Use a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="yourname@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Looms & Berries Tasks <yourname@gmail.com>"
